{
  "name": "football-prediction-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src scripts tests next.config.mjs eslint.config.mjs",
    "test": "node --no-warnings --test tests/*.test.mjs",
    "analytics:check": "python scripts/python/football_analytics_sources.py --check",
    "analytics:plot-demo": "python scripts/python/football_analytics_sources.py --plot-demo public/generated/football-analytics-demo.png",
    "check": "pnpm run lint && pnpm run test && pnpm run typecheck && pnpm run build",
    "deploy:check": "pnpm run typecheck && pnpm run build",
    "production:check": "node scripts/check-production-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "lucide-react": "1.23.0",
    "next": "16.2.11",
    "openai": "^6.47.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "^22.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
