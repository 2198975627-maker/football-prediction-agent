# Runtime mode
APP_ENV=development
PROVIDER_MODE=mock

# AI provider secrets. Never expose these to client-side code.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_INPUT_CENTS_PER_MILLION=75
OPENAI_OUTPUT_CENTS_PER_MILLION=600
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
HUNYUAN_MODEL=hy3
# Required before paid Hunyuan traffic. Enter current TokenHub prices in CNY cents per 1M tokens.
HUNYUAN_INPUT_CENTS_PER_MILLION=
HUNYUAN_OUTPUT_CENTS_PER_MILLION=

# Optional sports data providers. API-Football and football-data.org both offer free keys.
# API-Football supports either its direct dashboard key or the official RapidAPI channel.
# Configure at least one logical provider: API-Football (direct/RapidAPI), Sportmonks, or football-data.org.
THESPORTSDB_API_KEY=
API_FOOTBALL_KEY=
RAPIDAPI_FOOTBALL_KEY=
RAPIDAPI_FOOTBALL_HOST=api-football-v1.p.rapidapi.com
SPORTMONKS_API_KEY=
FOOTBALL_DATA_API_KEY=
# Mainland-friendly documented REST provider. Free trial includes fixtures, scores, standings and H2H.
ANYSPORT_API_KEY=
ANYSPORT_LINEUPS_ENABLED=false
STATSBOMB_API_TOKEN=
GITHUB_TOKEN=
PYTHON_ANALYTICS_ENABLED=false
SOCCERDATA_CACHE_DIR=.cache/soccerdata
FBREF_RATE_LIMIT_MS=6000
UNDERSTAT_RATE_LIMIT_MS=6000
SOFIFA_RATE_LIMIT_MS=6000
NAMI_SPORTS_USER=
NAMI_SPORTS_SECRET=
# The providers below remain contract/configuration slots until their vendor-specific API samples are supplied.
JUHE_FOOTBALL_API_KEY=
FEIJING_SPORTS_API_KEY=
APIBALLS_API_KEY=

# Optional search and extraction providers
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CURRENCY=cny
BILLING_MARKUP_MULTIPLIER=2
MIN_CHARGE_CENTS=100

# Database/auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ROSTER_CACHE_TABLE=football_roster_cache
SUPABASE_ROSTER_CACHE_READ_TIMEOUT_MS=6000
SUPABASE_MATCH_CACHE_TABLE=football_match_intelligence_cache
SUPABASE_PROVIDER_ENTITY_TABLE=football_provider_entities
SUPABASE_TRACKED_FIXTURES_TABLE=football_tracked_fixtures
MATCH_INTELLIGENCE_CACHE_SECONDS=900
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloud roster refresh. CRON_SECRET protects /api/cron/refresh-rosters.
CRON_SECRET=
ROSTER_REFRESH_MAX_TEAMS=72
ROSTER_REFRESH_MAX_PLAYERS_PER_TEAM=40

# Rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
