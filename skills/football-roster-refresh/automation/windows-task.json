{
  "name": "FootballRosterRefreshDaily",
  "schedule": {
    "frequency": "daily",
    "localTime": "00:00",
    "timezone": "Asia/Shanghai",
    "note": "Windows Task Scheduler uses the computer's local timezone. This project expects China Standard Time / UTC+08."
  },
  "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\skills\\football-roster-refresh\\scripts\\run-refresh.ps1",
  "registerCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\skills\\football-roster-refresh\\scripts\\register-windows-task.ps1",
  "outputDirectory": "data\\football-rosters",
  "logDirectory": "data\\football-rosters\\logs",
  "modelTokenUse": false,
  "networkProviders": [
    "https://www.thesportsdb.com"
  ],
  "writes": [
    "data\\football-rosters\\latest.json",
    "data\\football-rosters\\latest-changes.json",
    "data\\football-rosters\\history\\YYYY-MM-DD.json",
    "data\\football-rosters\\changes\\YYYY-MM-DD.json",
    "data\\football-rosters\\summary.md"
  ]
}
