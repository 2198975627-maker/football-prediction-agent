{
  "providerModeDefault": "mock",
  "secrets": {
    "neverExposeToClient": [
      "OPENAI_API_KEY",
      "HUNYUAN_API_KEY",
      "API_FOOTBALL_KEY",
      "RAPIDAPI_FOOTBALL_KEY",
      "SPORTMONKS_API_KEY",
      "FOOTBALL_DATA_API_KEY",
      "ANYSPORT_API_KEY",
      "NAMI_SPORTS_SECRET",
      "JUHE_FOOTBALL_API_KEY",
      "FEIJING_SPORTS_API_KEY",
      "APIBALLS_API_KEY",
      "TAVILY_API_KEY",
      "FIRECRAWL_API_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "SUPABASE_SERVICE_ROLE_KEY",
      "UPSTASH_REDIS_REST_TOKEN"
    ],
    "forbiddenPublicPrefixes": [
      "NEXT_PUBLIC_OPENAI",
      "NEXT_PUBLIC_HUNYUAN",
      "NEXT_PUBLIC_ANYSPORT",
      "NEXT_PUBLIC_NAMI",
      "NEXT_PUBLIC_JUHE",
      "NEXT_PUBLIC_FEIJING",
      "NEXT_PUBLIC_APIBALLS",
      "NEXT_PUBLIC_STRIPE_SECRET",
      "NEXT_PUBLIC_SUPABASE_SERVICE_ROLE",
      "NEXT_PUBLIC_UPSTASH_REDIS_REST_TOKEN"
    ]
  },
  "workflowGates": [
    {
      "id": "validate-input",
      "mustPassBefore": ["team-resolution"]
    },
    {
      "id": "billing-authorized",
      "mustPassBefore": ["sports-data-call", "search-call", "model-call"]
    },
    {
      "id": "cost-cap-check",
      "mustPassBefore": ["each-provider-call"]
    },
    {
      "id": "source-verification",
      "mustPassBefore": ["prediction-synthesis"]
    },
    {
      "id": "webhook-confirmed",
      "mustPassBefore": ["platform-paid-job-start"]
    }
  ],
  "billing": {
    "markupMultiplier": 2,
    "minimumChargeCents": 100,
    "clientSuppliedCostTrusted": false,
    "ledgerMustBeAppendOnly": true,
    "idempotencyRequired": true
  },
  "safety": {
    "bettingAdviceAllowed": false,
    "guaranteedPredictionAllowed": false,
    "privateLifeInferenceAllowed": false,
    "unsupportedSportsAllowedInMvp": false
  }
}
