# Production runtime
APP_ENV=production
NODE_ENV=production
PROVIDER_MODE=mock
LIVE_COSTS_ENABLED=false

# Public app URL after deployment, for your own records and future callbacks.
NEXT_PUBLIC_APP_URL=

# AI provider. Mainland deployments should use hunyuan; overseas deployments may use openai.
AI_PROVIDER=hunyuan
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_INPUT_CENTS_PER_MILLION=
OPENAI_CACHED_INPUT_CENTS_PER_MILLION=
OPENAI_OUTPUT_CENTS_PER_MILLION=
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
HUNYUAN_MODEL=hy3
# Required before LIVE_COSTS_ENABLED=true. Use current contract prices, in CNY cents per 1M tokens.
HUNYUAN_INPUT_CENTS_PER_MILLION=
HUNYUAN_CACHED_INPUT_CENTS_PER_MILLION=
HUNYUAN_OUTPUT_CENTS_PER_MILLION=

# Sports data. Set this on the server/cloud platform, never in browser code.
# API-Football and football-data.org can start with free registered keys.
THESPORTSDB_API_KEY=
API_FOOTBALL_KEY=
RAPIDAPI_FOOTBALL_KEY=
RAPIDAPI_FOOTBALL_HOST=api-football-v1.p.rapidapi.com
SPORTMONKS_API_KEY=
FOOTBALL_DATA_API_KEY=
ANYSPORT_API_KEY=
# Set true only when the AnySport account includes the Basic+ lineups endpoint.
ANYSPORT_LINEUPS_ENABLED=false
STATSBOMB_API_TOKEN=
GITHUB_TOKEN=
PYTHON_ANALYTICS_ENABLED=false
SOCCERDATA_CACHE_DIR=.cache/soccerdata
FBREF_RATE_LIMIT_MS=6000
UNDERSTAT_RATE_LIMIT_MS=6000
SOFIFA_RATE_LIMIT_MS=6000
NAMI_SPORTS_USER=
NAMI_SPORTS_SECRET=
JUHE_FOOTBALL_API_KEY=
FEIJING_SPORTS_API_KEY=
APIBALLS_API_KEY=

# Optional search and extraction providers, unused while PROVIDER_MODE=mock.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Payments. Keep disabled until real Stripe flow, webhook verification, and ledger settlement are implemented.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CURRENCY=cny
BILLING_MARKUP_MULTIPLIER=2
MIN_CHARGE_CENTS=100

# Database/auth/rate limiting providers for future production hardening.
SUPABASE_URL=
# Preferred modern Supabase keys.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Compatibility aliases. Leave blank when the modern names above are set.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ROSTER_CACHE_TABLE=football_roster_cache
SUPABASE_ROSTER_CACHE_READ_TIMEOUT_MS=6000
SUPABASE_MATCH_CACHE_TABLE=football_match_intelligence_cache
SUPABASE_PROVIDER_ENTITY_TABLE=football_provider_entities
SUPABASE_TRACKED_FIXTURES_TABLE=football_tracked_fixtures
MATCH_INTELLIGENCE_CACHE_SECONDS=900
CRON_SECRET=
ROSTER_REFRESH_MAX_TEAMS=72
ROSTER_REFRESH_MAX_PLAYERS_PER_TEAM=40
# Up to 3 API-Football calls per selected team (team, squad, coach).
ROSTER_API_FOOTBALL_TEAM_LIMIT=16
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
